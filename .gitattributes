# Force LF line endings for all text files. Production runs on Linux (RDS,
# Lambda, Fargate, Cloud9). LF prevents CRLF surprises when a developer on
# Windows edits a script or YAML file.

# Default for unrecognized text. Git will normalize on commit.
* text=auto eol=lf

# Source code
*.py    text eol=lf
*.sh    text eol=lf
*.sql   text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.mjs   text eol=lf
*.html  text eol=lf
*.css   text eol=lf

# Tabular data and prose
*.csv   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf

# Binaries. Mark explicitly so Git stops trying to diff or normalize them.
*.pdf    binary
*.xlsx   binary
*.xls    binary
*.gpkg   binary
*.dss    binary
*.zip    binary
*.tar.gz binary
*.a      binary
*.png    binary
*.jpg    binary
*.jpeg   binary
