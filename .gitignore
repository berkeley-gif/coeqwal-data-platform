# Python bytecode
__pycache__/
*.pyc

# Virtual environments
.venv/
venv/

# ruff cache
.ruff_cache/

# Log files
*.log

# Secrets and environment files
.env
.env.*
*.env

# IDE and OS junk
.vscode/
.idea/
*.code-workspace
.DS_Store

# Archived working notes
**/.archive/
**/_archive/

# Private infrastructure docs (AWS account IDs, ARNs)
docs/INFRASTRUCTURE.md

# Database: local-dev scripts and secrets
database/secrets/
database/setup_db_connection.sh
database/setup_developer_session.sql
database/scripts/*.sh

# Environment-specific SQL variants
database/scripts/sql/**/*_local.sql
database/scripts/sql/**/*_cloud9.sql

# ETL: development staging and reference
etl/**/output/
etl/**/audit_reports/
etl/statistics/charts/
etl/reference/
etl/verification/*.pdf

# Generated manifest, regenerated by load_all_tier_results.py
etl/tier_data/staging/tier_upload_manifest.csv

# Reference subdirs under specific pipelines stay tracked
!etl/tier_data/reference/
!etl/tier_data/reference/**
!etl/statistics/reference/
!etl/statistics/reference/**

# Audits: tarballs and regenerated verification outputs
# Unpacked monthly snapshots are tracked
audits/*.tar.gz
audits/verification_reports/
audits/validation_mismatches/

# AWS cost dumps (local-only)
costs/

# aws lambda invoke output file (per lambda READMEs)
**/response.json

# Default-ignore everything under data/, then re-allow the specific subdirs
# that should be tracked.
/data/*
!/data/README.md
!/data/raw/
/data/raw/*
!/data/raw/csv_from_CalSim_report_pdf/
!/data/raw/csv_from_CalSim_report_pdf/**
!/data/raw/pdf_tables_from_CalSim_report/
!/data/raw/pdf_tables_from_CalSim_report/**
!/data/reference/
/data/reference/*
!/data/reference/cws/
!/data/reference/cws/**
!/data/reference/CS3_NetworkSchematic-Hongbing.pdf

# LibreOffice lock files at any depth.
# Must stay below the data/ whitelist so it wins the last-match rule against
# `!/data/reference/cws/**` (which would otherwise un-ignore locks under data/).
**/.~lock.*
