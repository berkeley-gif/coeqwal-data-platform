etl/reference/

# Database utility scripts (local dev)
database/scripts/*.sh
database/setup_db_connection.sh
database/setup_developer_session.sql

# Local/environment-specific SQL scripts
database/scripts/sql/*_local.sql
database/scripts/sql/*_cloud9.sql
database/scripts/sql/**/*_local.sql
database/scripts/sql/**/*_cloud9.sql

# Seed tables are tracked in the repo AND mirrored to S3 (coeqwal-seeds-dev)
# database/seed_tables/   (intentionally NOT ignored)

# Local audit outputs (tracked). See etl/verification/README.md.
# Tarballs result when dat is downloaded directly from EC2/Cloud9 are kept local-only.
audits/*.tar.gz
# Generated verifier JSON reports and mismatch dumps. Regenerated on demand;
# not part of the committed audit record.
audits/verification_reports/
audits/validation_mismatches/
costs/

# Private infrastructure documentation (AWS account IDs, ARNs, runbooks)
docs/INFRASTRUCTURE.md

# /reference/ at the repo root is local-only.
# Large per-scenario dumps belong in S3 (coeqwal-model-run).
/reference/

**/reference/
!etl/tier_data/reference/
!etl/tier_data/reference/**
!etl/statistics/reference/
!etl/statistics/reference/**
