# Local data and processing directories
/CalSim3_schematic
/data


# Allow specific CSV directory from CalSim report
!/data/raw/csv_from_CalSim_report_pdf/
!/data/raw/csv_from_CalSim_report_pdf/**
# Ignore everything else in data
/data/*
!/data/raw/
/data/raw/*
!/data/raw/csv_from_CalSim_report_pdf/
/dss_processing

# ETL staging and output directories
etl/staging/
etl/*/staging/
# Tier staging CSVs are tracked so they can be pushed/pulled to Cloud9
!etl/tier_data/staging/
!etl/tier_data/staging/*.csv
etl/statistics/charts/
etl/coeqwal-etl/dss_processing/output/

# ETL runtime outputs (API responses, shell captures, generated SQL)
# etl/tier_data/all_tiers_upsert.sql is generated by the ETL python script and is not tracked in the repo
response.json
**/response.json
etl/statistics/echo
etl/tier_data/all_tiers_upsert.sql

# ETL verification outputs (track scripts, ignore generated PDFs)
etl/verification/*.pdf

# IDE and editor junk
.vscode/
.idea/
*.code-workspace
*.sublime*
.~lock.*

# OS
.DS_Store
Thumbs.db

# FastAPI / docs builds
/site/
docs/_build/
# Archived working documents (local development notes only)
.archive/
_archive/
*/.archive/
**/.archive/
api/coeqwal-api/routes/_archive/

# Large data/processing folders
CalSim3_schematic/
audits/
database/secrets/
.github/ISSUES/
etl/COEQWAL-pydsstools-archive/

# Large reference CSVs (used for local testing only, stored on S3)
etl/reference/

# Database utility scripts (local dev)
database/scripts/*.sh
database/setup_db_connection.sh
database/setup_developer_session.sql

# Local/environment-specific SQL scripts
database/scripts/sql/*_local.sql
database/scripts/sql/*_cloud9.sql
database/scripts/sql/**/*_local.sql
database/scripts/sql/**/*_cloud9.sql

# Seed tables are tracked in the repo AND mirrored to S3 (coeqwal-seeds-dev)
# database/seed_tables/   (intentionally NOT ignored)

# Local audit outputs
audits/

# Claude Code config (local)
.claude/