!/data/raw/pdf_tables_from_CalSim_report/
!/data/raw/pdf_tables_from_CalSim_report/**
!/data/reference/
!/data/reference/**
/dss_processing

# ETL staging and output directories
etl/staging/
etl/*/staging/
# Tier data: keep both the team-delivered raw drops under tier_results/ and
# the flat staging CSVs at the top of staging/ tracked. The flat CSVs are
# the inputs to load_all_tier_results.py.
!etl/tier_data/staging/
!etl/tier_data/staging/tier_results/
!etl/tier_data/staging/tier_results/**
etl/tier_data/staging/tier_upload_manifest.csv
etl/statistics/charts/
etl/batch-container/dss_processing/output/

etl/**/output/
etl/**/audit_reports/
response.json
**/response.json
etl/statistics/echo
etl/tier_data/all_tiers_upsert.sql

# ETL verification outputs (track scripts, ignore generated PDFs)
etl/verification/*.pdf

